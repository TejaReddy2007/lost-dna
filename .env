# LOST DNA — environment configuration
# `npm run setup` copies this file to .env and fills the secrets with random values.

# Port for the API server (the Vite dev server runs on 5173 and proxies /api to it)
PORT=4000

# Secret used to sign session tokens (min 16 chars). NEVER commit a real value.
JWT_SECRET=450d509688181e24cfc1129e356e0180e366131de19e9c78490cbda859274ac1

# Key used to encrypt private verification details at rest (AES-256-GCM, min 16 chars).
# Changing it makes existing private details unreadable — reset the demo data if you do.
DATA_ENCRYPTION_KEY=72c8b8286e23e5d9588061759bea5f36faf304b6c308c3364d413f6fce50e223

# SQLite database file and uploaded photo folder (relative to the project root)
DATABASE_PATH=data/lostdna.db
UPLOAD_DIR=data/uploads

# Demo mode: auto-load fictional demo data into an empty DB and allow "Reset demo data" in the admin panel
DEMO_MODE=true
# Password for all demo accounts (optional override)
DEMO_PASSWORD=LostDNA@demo1

# Set to true when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Set to 1 when running behind a hosting proxy (Render, Railway, Fly.io…)
TRUST_PROXY=
