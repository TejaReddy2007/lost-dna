{
  "name": "lost-dna",
  "version": "1.0.0",
  "private": true,
  "description": "LOST DNA — campus lost & found recovery platform prototype for SRM KTR",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs --quiet",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "seed": "tsx server/seed.ts",
    "reset-demo": "tsx server/seed.ts --reset",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prestart": "node scripts/setup.mjs --quiet",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "build:netlify": "npm run build && node scripts/netlify-redirects.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
